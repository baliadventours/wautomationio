# GEMINI_API_KEY: Optional if AI features are enabled
GEMINI_API_KEY=""

# APP_URL: The public URL of this application (used for Evolution API webhook callback registration)
APP_URL="https://your-domain.com"

# --- EVOLUTION API CONFIGURATION (VPS) ---
# The base URL of your self-hosted Evolution API running on your VPS
EVOLUTION_API_BASE_URL="https://wa.yourdomain.com"
# The global admin API key configured in your Evolution API docker-compose.yml (AUTHENTICATION_API_KEY)
EVOLUTION_API_ADMIN_KEY="your_evolution_admin_api_key_here"
# Shared secret for validating incoming webhooks from Evolution API to your SaaS backend
EVOLUTION_WEBHOOK_SECRET="your_shared_webhook_secret_here"

# --- SUPABASE CONFIGURATION ---
# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL="https://xyzproject.supabase.co"
# Supabase public anonymous key (for client-side auth & queries scoped by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
# Supabase Service Role key (server-side only, for admin triggers/webhooks)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# --- ENCRYPTION AT REST ---
# 32-byte hex or base64 key used to encrypt Evolution API per-instance tokens at rest
INSTANCE_TOKEN_ENCRYPTION_SECRET="super-secret-encryption-key-32chars"

# --- STRIPE BILLING (Optional / MVP Stub) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
